				QGroupBox {
				background: white;
				border: 1px solid #d9e2ec;
				border-radius: 10px;
				margin-top: 14px;
				font-weight: 600;
				color: #243b53;
				}
				QGroupBox::title {
				subcontrol-origin: margin;
				left: 14px;
				padding: 0 6px;
				}
				QLineEdit, QComboBox {
				min-height: 34px;
				border: 1px solid #bcccdc;
				border-radius: 6px;
				padding: 0 10px;
				background: white;
				}
				QLineEdit:focus, QComboBox:focus {
				border: 2px solid #2979ff;
				}
				QPushButton {
				min-height: 36px;
				border-radius: 6px;
				padding: 0 14px;
				font-weight: 600;
				}
				QPushButton#addButton {
				background: #1976d2;
				color: white;
				border: none;
				}
				QPushButton#editButton {
				background: #f9a825;
				color: #1f2933;
				border: none;
				}
				QPushButton#deleteButton {
				background: #c62828;
				color: white;
				border: none;
				}
				QPushButton#clearFormButton, QPushButton#clearSearchButton {
				background: #eef2f7;
				color: #334e68;
				border: 1px solid #cbd5e1;
				}
				QPushButton:disabled {
				background: #d9e2ec;
				color: #829ab1;
				}
				QTableWidget {
				background: white;
				border: 1px solid #d9e2ec;
